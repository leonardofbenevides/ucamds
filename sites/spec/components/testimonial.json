{
  "$schema": "../../../spec/schema/component.schema.json",
  "id": "testimonial",
  "name": "Testimonial",
  "selector": "ucam-site-testimonial",
  "status": "draft",
  "version": "0.1.0",
  "since": "0.1.5",
  "category": "conteudo",
  "description": "A fala de alguém e quem falou: um aluno, um egresso, uma empresa parceira. Uma figura com a citação e o nome, sem estrelas.",
  "quando_usar": [
    "Para a voz de quem passou pela instituição, com nome, curso e ano.",
    "Dois ou três lado a lado."
  ],
  "evidencia": {
    "origem": "candidomendes.edu.br e cenpre.candidomendes.edu.br (depoimentos), 09/10/2026",
    "ocorrencias": [
      {
        "tela": "www — depoimentos",
        "problema": "cinco estrelas em todo depoimento: uma nota que é sempre a máxima não informa nada"
      },
      {
        "tela": "www — depoimentos",
        "problema": "carrossel: um depoimento por vez, trocando sozinho"
      },
      {
        "tela": "cenpre — depoimentos",
        "rotulo": "nome e curso",
        "problema": "nenhum na forma: citação, nome e curso"
      }
    ],
    "conclusao": "Citação, nome e papel, parados e sem nota. O que dá crédito é o nome completo com curso e ano."
  },
  "anatomia": [
    {
      "parte": "root",
      "obrigatorio": true,
      "descricao": "<figure>. Caixa com borda."
    },
    {
      "parte": "quote",
      "obrigatorio": true,
      "descricao": "<blockquote>, em texto de abertura.",
      "classe": "ucam-site-testimonial__quote"
    },
    {
      "parte": "autor",
      "obrigatorio": true,
      "descricao": "<figcaption> com o avatar e o nome.",
      "classe": "ucam-site-testimonial__autor"
    },
    {
      "parte": "nome",
      "obrigatorio": true,
      "descricao": "O nome completo.",
      "classe": "ucam-site-testimonial__nome"
    },
    {
      "parte": "papel",
      "obrigatorio": true,
      "descricao": "Curso e ano, ou cargo e empresa.",
      "classe": "ucam-site-testimonial__papel"
    }
  ],
  "props": [
    {
      "nome": "quote",
      "tipo": "string",
      "obrigatorio": true,
      "descricao": "A fala."
    },
    {
      "nome": "name",
      "tipo": "string",
      "obrigatorio": true,
      "descricao": "Quem falou."
    },
    {
      "nome": "role",
      "tipo": "string",
      "obrigatorio": true,
      "descricao": "Curso e ano, ou cargo e empresa."
    },
    {
      "nome": "inverse",
      "tipo": "boolean",
      "default": "false",
      "descricao": "Sobre seção escura.",
      "valores": {
        "true": {
          "uso": "Numa faixa na superfície inversa.",
          "classe": ".ucam-site-testimonial--inverse"
        }
      }
    }
  ],
  "estados": [
    "default"
  ],
  "limites": {
    "regras": [
      "Sem estrelas.",
      "Sem carrossel: os depoimentos ficam à vista.",
      "Sem depoimento anônimo nem só com o primeiro nome.",
      "Até quatro frases."
    ],
    "motivo": "Depoimento vale pelo nome de quem deu. Estrela sempre cheia e fala sem sobrenome são o que faz a pessoa desconfiar."
  },
  "acessibilidade": {
    "requisitos": [
      "figure, blockquote e figcaption: a citação e a autoria ficam ligadas.",
      "O avatar é decorativo: o nome está escrito ao lado.",
      "Nada se move sozinho.",
      "Citação e nome a 4,5:1, no claro e no inverso, medidos no build."
    ],
    "criterios_wcag": [
      "1.3.1",
      "1.4.3",
      "2.2.2"
    ]
  },
  "conteudo": {
    "papel": {
      "bom": [
        "Direito, turma de 2024",
        "Gerente de RH, Aurora Engenharia"
      ],
      "ruim": [
        "Aluna",
        "Cliente satisfeito",
        "M. S."
      ]
    },
    "regras": [
      "A fala é de quem falou, sem retoque de publicidade.",
      "Nome completo, com curso e ano ou cargo e empresa.",
      "As aspas são da folha; não se digitam. A fala vai direto no blockquote, sem <p> dentro."
    ]
  },
  "composicao": {
    "usa": [
      "ucam-site-avatar"
    ]
  },
  "exemplos": [
    {
      "titulo": "Depoimento de egressa",
      "codigo": "<figure class=\"ucam-site-testimonial\">\n  <blockquote class=\"ucam-site-testimonial__quote\">Consegui o estágio no terceiro período, e foi o CENPRE que revisou meu currículo antes da entrevista.</blockquote>\n  <figcaption class=\"ucam-site-testimonial__autor\">\n    <span class=\"ucam-site-avatar\" aria-hidden=\"true\">AS</span>\n    <span><span class=\"ucam-site-testimonial__nome\">Ana de Souza</span><span class=\"ucam-site-testimonial__papel\">Direito, turma de 2024</span></span>\n  </figcaption>\n</figure>"
    }
  ],
  "boas_praticas": [
    {
      "faca": "Nome completo, curso e ano.",
      "evite": "Só o primeiro nome.",
      "porque": "Sem sobrenome, o depoimento parece inventado."
    },
    {
      "faca": "Dois ou três à vista.",
      "evite": "Carrossel de dez.",
      "porque": "O que troca sozinho ninguém termina de ler."
    }
  ],
  "implementacao": {
    "trilho_a": {
      "contrato": "Uma figure com a citação e a legenda de autoria.",
      "raiz": ".ucam-site-testimonial",
      "variaveis": [
        "--ucam-site-typography-lede-font-size",
        "--ucam-site-radius-card",
        "--ucam-site-space-inset-card"
      ]
    }
  }
}
